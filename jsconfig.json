{
  // First typecheck slice (npm run typecheck). strict stays off until a folder is clean.
  // tsc does not load this file unless invoked with -p jsconfig.json.
  // Widen one path at a time: see types/README.md.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [],
    "lib": ["ES2022"],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "shared/**/*.js",
    "server/sim/rng.js",
    "server/sim/detmath.js",
    "server/sim/dir.js",
    "server/sim/constants.js",
    "types/**/*.js"
  ],
  "exclude": [
    "shared/protocol.js",
    "shared/bandBonds.js",
    // [ACCOUNT] browser + Node in one file by design (crypto.subtle when available, a pure-JS fallback otherwise):
    // TextEncoder / Buffer / btoa are outside this slice's lib (ES2022, types: []) and the file must stay byte-for-byte
    // the same algorithm as the 盟约 build (accounts/accountCrypto.js interop). Same treatment as the two above.
    "shared/accountCrypto.js"
  ]
}
